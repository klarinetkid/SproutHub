DROP TABLE IF EXISTS "TblMoistureReadings";

DROP TABLE IF EXISTS "TblPlants";

CREATE TABLE "TblPlants" (
	"Id" INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
	"DisplayName" VARCHAR(50)
);

CREATE TABLE "TblMoistureReadings" (
	"Id" INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	"PlantId" INTEGER NOT NULL REFERENCES "TblPlants"("Id"),
	"MoistureReading" NUMERIC(5, 2) NOT NULL,
	"Date" TIMESTAMP NOT NULL
);

CREATE OR REPLACE VIEW "VwPlants" AS
SELECT 
    p."Id",
    p."DisplayName",
    r."MoistureReading" AS "LastMoistureReading",
    r."Date" AS "LastReadingDate"
FROM "TblPlants" p
LEFT JOIN (
    SELECT DISTINCT ON ("PlantId")
        "PlantId",
        "MoistureReading",
        "Date"
    FROM "TblMoistureReadings"
    ORDER BY "PlantId", "Date" DESC
) r ON r."PlantId" = p."Id";